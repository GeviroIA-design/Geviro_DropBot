# ============ Coeur scoring (existant) ============
BOT_SEED=42
N_PRODUCTS=30
FORECAST_HORIZON=14
OUTPUT_DIR=outputs
SAMPLE_CSV=data/sample_products.csv
LOG_LEVEL=INFO
USE_SAMPLE=false

# ============ Service 24/7 ============
# Persistance d'état (SQLite, stdlib).
STATE_DB_PATH=data/state.db
# Fichier de log (utilisé par /tail_logs).
LOG_FILE=logs/service.log
# Nombre de workers d'exécution.
WORKER_COUNT=2
# Cadence de la boucle superviseur (secondes).
TICK_INTERVAL=1.0
# Intervalles des jobs récurrents (secondes).
SCAN_INTERVAL=1800
EXPORT_INTERVAL=3600
# Heartbeat / watchdog.
HEARTBEAT_INTERVAL=15
HEARTBEAT_MAX_AGE=90
WATCHDOG_INTERVAL=30
JOB_TIMEOUT=300

# ============ Retry / Circuit breaker ============
MAX_RETRIES=4
RETRY_BASE_DELAY=2.0
RETRY_FACTOR=2.0
RETRY_MAX_DELAY=300
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60

# ============ Telegram admin ============
# Token du bot (BotFather). VIDE => console Telegram désactivée (no-op sûr).
TELEGRAM_BOT_TOKEN=
# IDs Telegram admin autorisés, séparés par des virgules. Ex: 123456789,987654321
TELEGRAM_ADMIN_IDS=
# Timeout du long-polling getUpdates (secondes).
TELEGRAM_POLL_TIMEOUT=30
# Rate limit : nb max de commandes par admin et par minute.
TELEGRAM_RATE_LIMIT=20
# Nb de lignes par défaut pour /tail_logs.
TAIL_LOG_LINES=20

# ============ Propositions d'achat + garde-fous ============
# Quantité proposée par défaut pour un produit BUY.
PROPOSAL_QUANTITY=10
# Plafond de dépense par commande (EUR) — refus au-delà.
MAX_EUR_PER_ORDER=200
# Quota de commandes exécutées par 24h.
MAX_ORDERS_PER_DAY=5
